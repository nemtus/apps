    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
