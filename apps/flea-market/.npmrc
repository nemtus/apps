# Supply-chain hardening: only install package versions that have been
# published for more than 7 days. This "cooldown" window gives malicious or
# compromised releases time to be detected and yanked before we pull them in.
# npm converts this to a `before` cutoff (Date.now() - days). Mirrors the
# Dependabot `cooldown` setting in .github/dependabot.yml.
min-release-age=7

# Narrow exemptions from the cooldown above, for the case npm documents it for:
# a security fix published inside the window, where waiting means shipping the
# advisory. Only the named package is exempt — its own dependencies still follow
# the policy. Keep this list short and delete entries once the cooldown has
# caught up with them.
#
# follow-redirects: reached through `axios`, so it is in the production tree of
# this browser SPA. 1.16.1 and earlier leak credential headers across origins
# (GHSA-q3jh-wrc6-jgq8, GHSA-8r9p-f939-6h3c, GHSA-mrwp-f3q8-3g9p); the fix is
# 1.16.2.
min-release-age-exclude[]=follow-redirects
